# Baseline versions for PR/push CI (reproducible builds). Renovate watches these lines
# and opens a PR when a new release appears; the weekly cron independently validates
# against the LIVE latest platform regardless of this file.
# QUARKUS_LANGCHAIN4J_BOM_VERSION is a release-watcher entry only — the platform BOM
# governs the extension version at build time, so this number is NOT what a build
# resolves. It tracks the standalone quarkiverse release and may run ahead of the
# platform: quarkus-bom 3.37.2 shipped quarkus-langchain4j 1.11.2 while this line
# already read 1.12.0. From platform 3.38.1 the two happen to coincide at 1.12.2.

# renovate: datasource=maven depName=io.quarkus.platform:quarkus-bom
QUARKUS_PLATFORM_VERSION=3.39.1
# renovate: datasource=maven depName=io.quarkiverse.langchain4j:quarkus-langchain4j-bom
QUARKUS_LANGCHAIN4J_BOM_VERSION=1.13.0
# renovate: datasource=java-version depName=java-jdk
JAVA_VERSION=25.0.4+7.0.LTS
