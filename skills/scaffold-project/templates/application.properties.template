# ============================================================================
# Quarkus + LangChain4j configuration
#
# Provider: Ollama, local-first. Requires a running Ollama (`ollama serve`,
# default endpoint http://localhost:11434) and the models pulled locally:
#   ollama pull qwen3:4b
#   ollama pull qwen3:1.7b
# qwen3 is what the official quarkus-langchain4j Ollama guide uses, and its
# tool-calling is markedly better than llama3.2's — which is what the tool and
# agent templates here exercise. Models with >= 3B parameters follow system
# prompts more reliably, so qwen3:4b is the default and qwen3:1.7b backs the
# "smaller" named model below.
# ============================================================================

# --- Ollama endpoint (uncomment to override the default) ---
# quarkus.langchain4j.ollama.base-url=http://localhost:11434

# --- Default chat model ---
quarkus.langchain4j.ollama.chat-model.model-id=qwen3:4b
quarkus.langchain4j.ollama.chat-model.temperature=0.7
quarkus.langchain4j.timeout=120s

# --- Named "smaller" model: cheap/fast subtasks (classification, query rewriting). ---
# Select it with @RegisterAiService(modelName = "smaller") or @ModelName("smaller").
# Use temperature 0 for deterministic, structured results.
quarkus.langchain4j.ollama.smaller.chat-model.model-id=qwen3:1.7b
quarkus.langchain4j.ollama.smaller.chat-model.temperature=0
quarkus.langchain4j.ollama.smaller.chat-model.num-predict=1024
quarkus.langchain4j.ollama.smaller.timeout=60s

# --- Observability: log prompts and responses in dev mode only (they record user content). ---
%dev.quarkus.langchain4j.log-requests=true
%dev.quarkus.langchain4j.log-responses=true

# --- Dev Services off: a real Ollama endpoint is configured above. ---
quarkus.langchain4j.devservices.enabled=false

# ============================================================================
# Cloud models (alternative to local). Requires an Ollama cloud account.
# Privacy note: the default configuration above is local — prompts never leave
# the machine. Switching to a cloud model sends prompt content (e.g. support
# tickets) to that provider; apply your organization's consent, redaction, and
# data-retention rules first.
#   quarkus.langchain4j.ollama.chat-model.model-id=deepseek-v4-pro:cloud
#   quarkus.langchain4j.ollama.smaller.chat-model.model-id=gpt-oss:20b-cloud
# ============================================================================

# ============================================================================
# RAG (Easy RAG) — uncomment when the quarkus-langchain4j-easy-rag extension and
# an in-process embedding model (langchain4j-embeddings-bge-small-en-v15-q) are on
# the classpath. Documents in this folder are ingested into an in-memory store on
# startup; the in-process embedding model is detected automatically (no config).
# ============================================================================
# quarkus.langchain4j.easy-rag.path=src/main/resources/rag

# ============================================================================
# MCP client — uncomment when the langchain4j-mcp extension is present. Declares
# a named client ("ops") whose tools an AI service imports with @McpToolBox("ops").
# streamable-http is the recommended transport; stdio spawns a local server process.
# Point clients only at servers you operate or explicitly trust — see the note in
# McpClient.java.template.
# ============================================================================
# quarkus.langchain4j.mcp.ops.transport-type=streamable-http
# quarkus.langchain4j.mcp.ops.url=http://localhost:8081/mcp
## stdio alternative (local subprocess). Replace BOTH placeholders below with a
## server you operate or explicitly trust, pinned to an exact version. `npm exec`
## needs the package already installed or --yes: a stdio pipe cannot answer a prompt.
# quarkus.langchain4j.mcp.ops.transport-type=stdio
# quarkus.langchain4j.mcp.ops.command=npm,exec,--yes,<your-mcp-server>@<exact-version>

# ============================================================================
# MCP server — uncomment when the mcp-server-http extension is present. The
# Streamable HTTP endpoint is served at /mcp by default. Traffic logging prints
# every JSON-RPC exchange, so it is %dev.-scoped below: it records user content.
# In production, restrict /mcp to trusted, authorized clients (see the Security
# block below).
# ============================================================================
# quarkus.mcp.server.http.root-path=/mcp
# %dev.quarkus.mcp.server.traffic-logging.enabled=true
# %dev.quarkus.mcp.server.traffic-logging.text-limit=500

# ============================================================================
# Security (production) — the scaffolded endpoints ship open so dev mode runs
# without an identity store. Before exposing them beyond local dev or an
# internal gateway, add an auth extension (e.g. quarkus-oidc) and protect the
# HTTP surface; @Authenticated / @RolesAllowed work on WebSockets Next
# endpoints, and an HttpUpgradeCheck can gate the handshake (websockets-next
# reference, "Security"; quarkus-langchain4j secure-sql-chatbot sample).
# ============================================================================
# quarkus.oidc.auth-server-url=https://your-idp.example.com/realms/app
# quarkus.oidc.client-id=your-client-id
## A browser cannot send an Authorization header on a WebSocket upgrade, so browser
## clients need the web-app (cookie/session) type; bearer-only ("service", the
## default) suits non-browser clients, which an HttpUpgradeCheck can admit instead.
# quarkus.oidc.application-type=web-app
## Permission paths are matched exactly, with no implicit wildcard: list /mcp AND
## /mcp/*, because the MCP server also serves /mcp/sse and /mcp/messages/* under
## its root-path.
# quarkus.http.auth.permission.authenticated.paths=/ws/triage,/mcp,/mcp/*
# quarkus.http.auth.permission.authenticated.policy=authenticated

# ============================================================================
# Observability — uncomment when quarkus-micrometer-registry-prometheus and
# quarkus-opentelemetry are on the classpath. AI-service metrics (incl. GenAI
# token usage gen_ai.client.token.usage) and per-service/per-tool spans are then
# emitted automatically; metrics are scraped at /q/metrics. Keys below only tune it.
# ============================================================================
## Ship traces to an OTLP collector (the default endpoint, shown explicitly):
# quarkus.otel.exporter.otlp.traces.endpoint=http://localhost:4317
## Copy prompt/completion text onto spans (records user content) — %dev.-scoped, so
## uncommenting cannot leak it from a production profile:
# %dev.quarkus.langchain4j.tracing.include-prompt=true
# %dev.quarkus.langchain4j.tracing.include-completion=true

# ============================================================================
# Error contract (RFC 9457) — nothing to uncomment: the http-problem extension
# works as soon as it is on the classpath, turning an exception that escapes a
# resource into an application/problem+json response instead of a raw 500. The
# keys below only tune it; include-details stays false so parser and binding
# failures do not echo internal class names back to the caller.
# ============================================================================
## Return 422 instead of 400 for bean-validation failures:
# quarkus.http-problem.constraint-violation.status=422
## Copy MDC keys into the problem document (e.g. a correlation id):
# quarkus.http-problem.include-mdc-properties=uuid
## Echo raw parser messages in "detail" (leaks internal class names) — %dev.-scoped,
## so production keeps the default false:
# %dev.quarkus.http-problem.include-details=true

# ============================================================================
# Agent skills — uncomment when the langchain4j-skills extension is present.
# Each listed directory holds one subdirectory per skill, each with a SKILL.md
# whose YAML front matter declares the skill's name and description. Pair with
# @Skills on the AI service (see AiService.java.template). status:preview.
# ============================================================================
# quarkus.langchain4j.skills.directories=skills,classpath:other-skills
