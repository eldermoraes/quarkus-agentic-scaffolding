package org.acme.dto;

/**
 * A closed set as an enum, not a String: the JSON schema sent to the model lists these values,
 * and an answer with any other value fails to parse, so CompleteAnswerGuard asks the model again.
 * Clients receive the value as a plain string ("HIGH").
 */
public enum PriorityLevel { LOW, MEDIUM, HIGH }

