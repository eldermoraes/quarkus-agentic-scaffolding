package org.acme.dto;

import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
import com.fasterxml.jackson.annotation.JsonProperty;

/**
 * An agent's typed result. @JsonProperty(required = true) lists each field as required in the
 * JSON schema sent to the model; a model may still ignore the schema, so CompleteAnswerGuard
 * enforces it on the answer. @JsonIgnoreProperties(ignoreUnknown = true) lets an answer carry
 * extra fields: the guard rejects missing and empty ones, not additions.
 */
@JsonIgnoreProperties(ignoreUnknown = true)
public record CategoryReport(
        @JsonProperty(required = true) String category,
        @JsonProperty(required = true) String reason) {}

