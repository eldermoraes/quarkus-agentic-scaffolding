package org.acme.workflow;

import org.acme.dto.ProgressUpdate;
import org.acme.dto.TriageReport;
import dev.langchain4j.guardrail.InputGuardrailException;
import io.smallrye.mutiny.Multi;
import io.smallrye.mutiny.subscription.MultiEmitter;
import jakarta.enterprise.context.ApplicationScoped;
import jakarta.inject.Inject;
import org.jboss.logging.Logger;

/**
 * Streaming bridge: reactive types stay at the edge. The blocking agent workflow runs on a
 * virtual thread; progress is emitted into a Mutiny Multi for the WebSocket.
 */
@ApplicationScoped
public class TriageBridge {

    private static final Logger LOG = Logger.getLogger(TriageBridge.class);

    /**
     * Edge limit on the raw ticket, kept in step with PromptInjectionGuard.MAX_INPUT_CHARS
     * (Guardrails.java.template) — templates cannot share a constant, so the two are aligned by
     * value. This one fails fast before any model call; the guardrail is the second line.
     */
    private static final int MAX_TICKET_CHARS = 4_000;

    @Inject
    TriageAgent triageAgent;

    public Multi<ProgressUpdate> triage(String ticket) {
        // Validate at the edge: user input never enters the pipeline unchecked.
        if (ticket == null || ticket.isBlank()) {
            return Multi.createFrom().item(ProgressUpdate.error("Ticket must not be empty."));
        }
        if (ticket.length() > MAX_TICKET_CHARS) {
            return Multi.createFrom().item(ProgressUpdate.error(
                    "Ticket exceeds the " + MAX_TICKET_CHARS + "-character limit."));
        }
        return Multi.createFrom().emitter(emitter ->
                Thread.startVirtualThread(() -> run(ticket, emitter)));
    }

    private void run(String ticket, MultiEmitter<? super ProgressUpdate> emitter) {
        try {
            emitter.emit(ProgressUpdate.started());
            TriageReport report = triageAgent.triage(ticket);
            emitter.emit(ProgressUpdate.done(report));
            emitter.complete();
        } catch (Exception e) {
            // Expose nothing: emitter.fail(e) would reach the client through @OnError carrying
            // the exception message (class names, endpoints, prompt fragments).
            InputGuardrailException rejection = guardrailRejection(e);
            if (rejection != null) {
                // The guard refused the ticket: a rejection, not a server failure.
                LOG.infof("Ticket rejected by the input guardrail: %s", rejection.getMessage());
            } else {
                LOG.error("Triage failed", e);
            }
            emitter.emit(ProgressUpdate.failed());
            emitter.complete();
        }
    }

    /** The workflow wraps an agent's exception, so the guard's rejection sits in the cause chain. */
    private static InputGuardrailException guardrailRejection(Throwable failure) {
        for (Throwable t = failure; t != null; t = t.getCause()) {
            if (t instanceof InputGuardrailException rejection) {
                return rejection;
            }
        }
        return null;
    }
}

