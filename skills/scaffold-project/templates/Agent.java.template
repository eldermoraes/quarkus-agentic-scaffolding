/* ===================== File: dto/ProgressUpdate.java ===================== */
package org.acme.dto;

/** Event/step type streamed to the client. A sealed hierarchy is a good fit as this grows. */
public record ProgressUpdate(String state, TriageReport result, String error) {
    public static ProgressUpdate started()              { return new ProgressUpdate("STARTED", null, null); }
    public static ProgressUpdate done(TriageReport r)   { return new ProgressUpdate("DONE", r, null); }
    /** Only for messages *we* author (validation), never for exception text. */
    public static ProgressUpdate error(String message)  { return new ProgressUpdate("ERROR", null, message); }
    /** Client-safe failure: an exception message can carry class names, endpoints or prompts. */
    public static ProgressUpdate failed()               { return error("Triage failed. Please try again."); }
}

/* ===================== File: guardrails/CompleteAnswerGuard.java ===================== */
package org.acme.guardrails;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import dev.langchain4j.guardrail.OutputGuardrailRequest;
import dev.langchain4j.guardrail.OutputGuardrailResult;
import dev.langchain4j.guardrails.JsonExtractorOutputGuardrail;
import dev.langchain4j.invocation.InvocationContext;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;
import org.jboss.logging.Logger;

/**
 * Output guardrail for a service that returns a record: the answer must parse as that record
 * and leave no field empty (missing, null, blank or an empty list, in nested records too).
 * Otherwise the model is asked
 * again; after quarkus.langchain4j.guardrails.max-retries attempts the call fails with an
 * OutputGuardrailException instead of returning a record full of nulls.
 *
 * The JSON schema a service sends does not make a model comply: small models may answer {},
 * and some cloud models ignore the schema (see application.properties.template). Subclass this
 * once per record type and attach the subclass with @OutputGuardrails.
 *
 * The parent parses with a default ObjectMapper, which rejects a field the record does not
 * declare. Annotate each record it parses, nested ones included, with
 * @JsonIgnoreProperties(ignoreUnknown = true) so an extra field a model adds is not a reason to
 * ask again. The parent lives in the langchain4j-guardrails artifact (see pom.xml.template).
 */
public abstract class CompleteAnswerGuard<T> extends JsonExtractorOutputGuardrail<T> {

    private static final Logger LOG = Logger.getLogger(CompleteAnswerGuard.class);
    private static final ObjectMapper JSON = new ObjectMapper();

    protected CompleteAnswerGuard(Class<T> type) {
        super(type);
    }

    @Override
    public OutputGuardrailResult validate(OutputGuardrailRequest request) {
        // Not JSON, or a field marked @JsonProperty(required = true) is absent: the parent
        // asks the model again.
        OutputGuardrailResult parsed = super.validate(request);
        if (!parsed.isSuccess()) {
            LOG.warnf("Answer from %s is not JSON or lacks a required field", caller(request));
            return parsed;
        }
        List<String> empty = new ArrayList<>();
        collectEmpty(JSON.valueToTree(parsed.successfulResult()), "", empty);
        if (empty.isEmpty()) {
            return parsed;
        }
        // Server log only: the field names say which agent and prompt need tuning.
        LOG.warnf("Incomplete answer from %s: empty %s", caller(request), empty);
        return reprompt("Incomplete answer: " + String.join(", ", empty) + " empty.",
                "Answer again with the same JSON object, every field filled in, including: "
                        + String.join(", ", empty) + ".");
    }

    private static void collectEmpty(JsonNode node, String path, List<String> empty) {
        if (node == null || node.isNull() || (node.isTextual() && node.asText().isBlank())
                || (node.isArray() && node.isEmpty())) {
            empty.add(path.isEmpty() ? "answer" : path);
        } else if (node.isArray()) {
            for (int i = 0; i < node.size(); i++) {
                collectEmpty(node.get(i), path + "[" + i + "]", empty);
            }
        } else if (node.isObject()) {
            for (Map.Entry<String, JsonNode> field : node.properties()) {
                collectEmpty(field.getValue(), path.isEmpty() ? field.getKey() : path + "." + field.getKey(), empty);
            }
        }
    }

    private static String caller(OutputGuardrailRequest request) {
        InvocationContext context = request.requestParams().invocationContext();
        return context == null ? "an AI service" : context.interfaceName() + "." + context.methodName();
    }
}

